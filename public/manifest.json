{
    "manifest_version": 3,
    "name": "NorthVault Extension",
    "version": "1.0.0",
    "description": "Secure password vault in your browser",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "storage"
    ]
}